# Prowlarr Container
resource "docker_container" "prowlarr" {
  name  = "prowlarr"
  image = "lscr.io/linuxserver/prowlarr:latest"

  # Network mode - uses Gluetun's network
  # Note: Terraform Docker provider uses "container:" not "service:" (Docker Compose uses "service:")
  network_mode = "container:gluetun"

  # Environment variables
  env = [
    "PUID=${var.puid}",
    "PGID=${var.pgid}",
    "TZ=${var.timezone}"
  ]

  # Volumes
  volumes {
    host_path      = var.prowlarr_config_path
    container_path = "/config"
  }

  # Security options
  security_opts = ["no-new-privileges:true"]

  # Health check - accepts 401 (Unauthorized) as healthy since service requires authentication
  healthcheck {
    test        = ["CMD-SHELL", "curl -f http://localhost:9696/api/v1/system/status || curl -s -o /dev/null -w '%%{http_code}' http://localhost:9696/api/v1/system/status | grep -q '401'"]
    interval    = "30s"
    timeout     = "10s"
    retries     = 3
    start_period = "40s"
  }

  # Labels
  labels {
    label = "homelab.service"
    value = "media"
  }

  labels {
    label = "homelab.type"
    value = "indexer"
  }

  labels {
    label = "managed_by"
    value = "terraform"
  }

  restart = "unless-stopped"

  depends_on = [
    docker_container.gluetun,
    null_resource.wait_for_gluetun,
    docker_container.flaresolverr
  ]
}

# FlareSolverr Container
resource "docker_container" "flaresolverr" {
  name  = "flaresolverr"
  image = "ghcr.io/flaresolverr/flaresolverr:latest"

  # Network mode - uses Gluetun's network
  # Note: Terraform Docker provider uses "container:" not "service:" (Docker Compose uses "service:")
  network_mode = "container:gluetun"

  # Environment variables
  env = [
    "TZ=${var.timezone}",
    "LOG_LEVEL=info",
    "LOG_FILE="
  ]

  # Volumes
  volumes {
    host_path      = var.flaresolverr_config_path
    container_path = "/config"
  }

  # Security options
  security_opts = ["no-new-privileges:true"]

  # Health check - accepts 405 (Method Not Allowed) as healthy since service is responding
  healthcheck {
    test        = ["CMD-SHELL", "curl -f http://localhost:8191/v1 || curl -s -o /dev/null -w '%%{http_code}' http://localhost:8191/v1 | grep -qE '(200|405)'"]
    interval    = "30s"
    timeout     = "10s"
    retries     = 3
    start_period = "40s"
  }

  # Labels
  labels {
    label = "homelab.service"
    value = "media"
  }

  labels {
    label = "homelab.type"
    value = "utility"
  }

  labels {
    label = "managed_by"
    value = "terraform"
  }

  restart = "unless-stopped"

  depends_on = [
    docker_container.gluetun,
    null_resource.wait_for_gluetun
  ]

  # Wait for gluetun to be running before starting
  must_run = true
}
