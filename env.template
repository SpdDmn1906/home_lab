# Home Lab Environment Variables Template
# Copy this file to .env and customize for your environment

# Project Settings
COMPOSE_PROJECT_NAME=homelab
TZ=America/Los_Angeles

# Paths
# If you are deploying on mediaserver (192.168.1.11), see:
#   config/mediaserver.env.example
MEDIA_ROOT=/path/to/media
CONFIG_ROOT=/path/to/config
DATA_ROOT=/path/to/data
BACKUP_ROOT=/path/to/backups

# NAS Configuration
NAS_IP=192.168.1.20
NAS_USER=admin
NAS_SHARE_MEDIA=/volume1/media
NAS_SHARE_CONFIG=/volume1/config

# Network Configuration
NETWORK_SUBNET=192.168.1.0/24
GATEWAY=192.168.1.1
DNS_PRIMARY=192.168.1.11
DNS_SECONDARY=8.8.8.8

# Plex Configuration
PLEX_CLAIM_TOKEN=
PLEX_USER=
PLEX_PASS=
PLEX_CONFIG_PATH=/app/plex/config
PLEX_MEDIA_PATH=/home/youruser/synology/Media
PLEX_EXTERNAL_PATH=/external

# STARR Stack Configuration
STARR_USERNAME=admin
STARR_PASSWORD=
# Bazarr (subtitles) - requires same MEDIA_PATH as Sonarr/Radarr
BAZARR_CONFIG_PATH=

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_please

# Prometheus
PROMETHEUS_RETENTION=30d

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # 2 AM daily
BACKUP_RETENTION_DAYS=30

# Security
API_KEYS_GENERATED=false
# Generate unique API keys for each service



