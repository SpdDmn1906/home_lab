# mediaserver (192.168.1.11) - audited defaults
# Copy to .env in the directory of the stack you are deploying, then adjust only if you change paths.

# User IDs (from audit: UID=1000, GID=1004)
PUID=1000
PGID=1004

# Timezone
TZ=America/New_York

# Base paths (from audit)
DOCKER_CONFIG_PATH=/home/youruser/Docker/config
MEDIA_ROOT=/data/media
EXTERNAL_MEDIA_ROOT=/external/media
SYNOLOGY_ROOT=/data/synology

# STARR stack (from audit)
GLUETUN_CONFIG_PATH=${DOCKER_CONFIG_PATH}/data_gluetun
QBITTORRENT_CONFIG_PATH=/usr/local/bin/qbittorrent/config
RADARR_CONFIG_PATH=/usr/local/bin/radarr/config
SONARR_CONFIG_PATH=/usr/local/bin/sonarr/config
PROWLARR_CONFIG_PATH=/usr/local/bin/prowlarr/data
FLARESOLVERR_CONFIG_PATH=/usr/local/bin/flaresolverr/data
BAZARR_CONFIG_PATH=/usr/local/bin/bazarr/config

# Media paths (Bazarr must use same MEDIA_PATH as Sonarr/Radarr)
MEDIA_PATH=/data/media

# Plex
PLEX_CONFIG_PATH=/app/plex/config
PLEX_MEDIA_PATH=/home/youruser/synology/Media
PLEX_EXTERNAL_PATH=/external

# Network
MEDIA_SERVER_IP=192.168.1.11
NAS_IP=192.168.1.20

